<Project>
  <!-- 仅对 .NET 托管项目生效；C++ 的 .vcxproj 不读取这些属性，用条件避免干扰。 -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- 支持的最低 Windows 版本（WinRT BLE 需要 10.0.15063+；这里取常用基线） -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <!--
      PlatformTarget 跟随 Platform：以前这里写死 x64，用 -r win-arm64 发布时会与 RID
      冲突，产出的程序集架构不对。默认仍是 x64，日常开发与既有脚本不受影响。
    -->
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
  </PropertyGroup>

  <!-- 版本/公司信息对所有项目通用。 -->
  <PropertyGroup>
    <Company>immurok</Company>
    <Product>immurok for Windows</Product>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <FileVersion>0.6.0.0</FileVersion>
    <Copyright>Copyright © immurok</Copyright>
  </PropertyGroup>
</Project>
