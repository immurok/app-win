<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ImmurokService</RootNamespace>
    <AssemblyName>ImmurokService</AssemblyName>
    <!-- Windows Service 宿主 -->
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <!-- DPAPI（ProtectedData / DataProtectionScope）在现代 .NET 中是独立包 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <!-- 接管 / 还原 Windows 内置 ssh-agent 服务（SshAgentServer 要占同名管道） -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
    <!-- 仅用于把设备的 compressed P-256 公钥解压成 uncompressed 点（BCL 不直接支持） -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <!-- 结构化日志：滚动日志文件（服务模式下无控制台，日志需落盘） -->
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImmurokCommon\ImmurokCommon.csproj" />
    <!-- 把终端提示助手的产物拷进本项目输出目录（不引用其程序集） -->
    <ProjectReference Include="..\ImmurokConsolePrompt\ImmurokConsolePrompt.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 单元测试要碰 Wsl/ 下的 internal 纯逻辑（前导行解析、HCS 结果解析）。 -->
    <InternalsVisibleTo Include="ImmurokTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 开发期日志配置，拷到输出目录供 Host 读取 -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
