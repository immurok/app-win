<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ImmurokClient</RootNamespace>
    <AssemblyName>ImmurokClient</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\immurok.ico</ApplicationIcon>
    <WslPayloadPath Condition="'$(WslPayloadPath)' == ''">$(MSBuildThisFileDirectory)..\packaging\wsl\immurok-wsl-payload.tar.gz</WslPayloadPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fluent / WinUI 观感控件库 -->
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <!-- 系统托盘 -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImmurokCommon\ImmurokCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图标作为 WPF 资源，供 pack:// URI 引用 -->
    <Resource Include="Assets\immurok.ico" />
    <Resource Include="Assets\immurok.png" />
    <!-- 白色版 logo：暗色主题下标题栏图标使用 -->
    <Resource Include="Assets\immurok-white.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- WSL2 支持的 Linux 侧 payload（桥、imk、PAM 模块 + 安装脚本），客户端打开开关时灌进发行版。
         它是 Linux 构建产物（wsl\build-payload.sh），不入库，默认在 packaging\wsl\ 下：
         发布工作流的 Linux job 和本机在 WSL 里跑脚本都输出到那里。build-installer.ps1 核对过内容后
         用 -p:WslPayloadPath 显式传进来。文件不存在时照常编译，开关会提示「缺少 WSL 组件包」。 -->
    <Content Include="$(WslPayloadPath)" Condition="Exists('$(WslPayloadPath)')"
             Link="wsl\immurok-wsl-payload.tar.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 多语言字符串内嵌为程序集资源；LogicalName 锁死资源名，供 Loc 按 code 加载 -->
    <None Remove="Localization\Strings\*.json" />
    <EmbeddedResource Include="Localization\Strings\*.json">
      <LogicalName>ImmurokClient.Localization.Strings.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
