<ui:FluentWindow x:Class="ImmurokClient.Views.PairDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:ImmurokClient.Localization"
                 Width="460"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Tr device.pair.start}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,22">
            <!-- 设备示意图跟着阶段换：等指纹画顶面 + 手指，等按钮画底面 + 光环，交换密钥定格。
                 由 ApplyStage 填充；换阶段时重建，让动画从头起动。 -->
            <ContentControl x:Name="IllustrationHost" HorizontalAlignment="Center" Margin="0,0,0,8" />

            <TextBlock x:Name="HeadText" Text="" FontSize="13" Opacity="0.7"
                       TextWrapping="Wrap" Margin="0,0,0,14" />

            <!-- 步骤 1。首次配对没有指纹这一步，整卡隐藏，第二卡的序号改成 1。 -->
            <Border x:Name="Step1Card" CornerRadius="8" Padding="14,12" Margin="0,0,0,8"
                    Background="#14808080">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Step1Badge" Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                            Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock x:Name="Step1Num" Text="1" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="Step1Title" Text="" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock x:Name="Step1Hint" Text="" FontSize="12" Opacity="0.6"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 步骤 2（首次配对时它就是唯一一步） -->
            <Border x:Name="Step2Card" CornerRadius="8" Padding="14,12" Background="#14808080">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Step2Badge" Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                            Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock x:Name="Step2Num" Text="2" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="Step2Title" Text="" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock x:Name="Step2Hint" Text="" FontSize="12" Opacity="0.6"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Text="" FontSize="12" Opacity="0.8"
                       TextWrapping="Wrap" Margin="0,14,0,0" MinHeight="32" />
            <!-- 按钮门客户端取消不了，只有长按设备或等 30 秒：等按钮时把出路写在脚注里。 -->
            <TextBlock x:Name="CancelHint" Text="{loc:Tr pair.dlg.cancelhint}" FontSize="11" Opacity="0.55"
                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <ui:Button x:Name="CloseBtn" Content="{loc:Tr common.cancel}"
                           Appearance="Secondary" MinWidth="96" Click="OnCloseClick" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
