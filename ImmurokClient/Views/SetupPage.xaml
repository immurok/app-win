<Page x:Class="ImmurokClient.Views.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImmurokClient.Localization"
      xmlns:h="clr-namespace:ImmurokClient.Helpers"
      xmlns:c="clr-namespace:ImmurokClient.Controls"
      Title="{loc:Tr nav.setup}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" h:WheelScroll.Enabled="True">
        <c:PageContainer>
            <StackPanel>
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{loc:Tr nav.setup}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{loc:Tr setup.pass}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <!-- 设置向导：首启自动弹出，之后从这里或托盘菜单随时再开 -->
                <c:SettingCard Icon="HatGraduation24" Title="{loc:Tr setup.wizard}"
                               Description="{loc:Tr setup.wizard.desc}" Margin="0,0,0,4">
                    <c:SettingCard.Action>
                        <ui:Button Content="{loc:Tr setup.wizard.open}" Appearance="Secondary" Click="OnOpenWizardClick" />
                    </c:SettingCard.Action>
                </c:SettingCard>

                <!-- 语言 -->
                <c:SettingCard Icon="Globe24" Title="{loc:Tr setup.language}"
                               Description="{loc:Tr setup.language.desc}" Margin="0,0,0,4">
                    <c:SettingCard.Action>
                        <ComboBox x:Name="LangCombo" MinWidth="180"
                                  DisplayMemberPath="Name" SelectedValuePath="Code"
                                  AutomationProperties.Name="{loc:Tr setup.language}"
                                  SelectionChanged="OnLanguageChanged" />
                    </c:SettingCard.Action>
                </c:SettingCard>

                <!-- 开机自启：开关在右侧，卡片标题就是它的名字，不再另带一行「启用」文字 -->
                <c:SettingCard Icon="Power24" Title="{loc:Tr setup.autostart}"
                               Description="{loc:Tr setup.autostart.desc}" Margin="0,0,0,16">
                    <c:SettingCard.Action>
                        <ui:ToggleSwitch x:Name="AutoStartToggle" Click="OnAutoStartToggle"
                                         AutomationProperties.Name="{loc:Tr setup.autostart.enable}" />
                    </c:SettingCard.Action>
                    <TextBlock x:Name="AutoStartFail" Text="{loc:Tr setup.autostart.fail}"
                               Style="{StaticResource CaptionCaution}" Margin="38,6,0,0" Visibility="Collapsed" />
                </c:SettingCard>

                <!-- 解锁密码 -->
                <c:SettingCard Icon="Key24" Title="{loc:Tr setup.pass.label}"
                               Description="{loc:Tr setup.pass.desc}" Margin="0,0,0,4">
                    <StackPanel x:Name="PassCardPanel" Margin="38,10,0,0">
                        <!-- 状态 + 操作：已配置时悬停显示清除；未配置时始终显示设置。
                             整行套一层 Background="Transparent" 的 Border 当悬停区：
                             StackPanel 默认 Background=null 不参与命中测试，鼠标走到
                             文字与按钮之间的空隙时会「悬空」，IsMouseOver 变 false，
                             按钮还没够到就先隐藏了。透明背景才会被命中测试。 -->
                        <Border x:Name="PassStatusRow" Background="Transparent" MinHeight="32"
                                MouseEnter="OnPassRowHover" MouseLeave="OnPassRowHover">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PassStateText" Text="{loc:Tr status.querying}"
                                           Style="{StaticResource BodyStrong}" VerticalAlignment="Center" />
                                <ui:Button x:Name="ClearBtn" Content="{loc:Tr common.clear}" Icon="{ui:SymbolIcon Delete24}"
                                           Appearance="Secondary" Click="OnClearClick" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <ui:Button x:Name="SetBtn" Content="{loc:Tr setup.pass.set}" Icon="{ui:SymbolIcon Key24}"
                                           Appearance="Primary" Click="OnSetClick" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Tr setup.pass.account}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock x:Name="UserText" Text="" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="PassHint" Text="" Margin="0,6,0,0" Style="{StaticResource StatusLine}" FontSize="12" />
                    </StackPanel>
                </c:SettingCard>

                <c:SettingCard Icon="ShieldKeyhole24" Title="Credential Provider"
                               Description="{loc:Tr setup.cp.desc}" Margin="0,0,0,4" />

                <ui:InfoBar Title="{loc:Tr dialog.tip}" Margin="0,8,0,0"
                            Message="{loc:Tr setup.pass.hint}"
                            Severity="Informational" IsOpen="True" IsClosable="False" />
            </StackPanel>
        </c:PageContainer>
    </ScrollViewer>
</Page>
