<Page x:Class="ImmurokClient.Views.PasswordInjectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImmurokClient.Localization"
      xmlns:h="clr-namespace:ImmurokClient.Helpers"
      xmlns:c="clr-namespace:ImmurokClient.Controls"
      xmlns:v="clr-namespace:ImmurokClient.Views"
      Title="{loc:Tr nav.inject}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" h:WheelScroll.Enabled="True">
        <c:PageContainer>
            <StackPanel>
                <!-- 页头：「添加」是本页的主要动作，放右上角；窄到放不下时折到说明下面 -->
                <c:AdaptiveRow Margin="0,0,0,20" MinMainWidth="300" TrailingAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr inject.title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{loc:Tr inject.subtitle}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <ui:Button Content="{loc:Tr inject.add}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                               Margin="0,6,0,0" Click="OnAddClick" />
                </c:AdaptiveRow>

                <!-- 注入项本身是本地配置，未配对也能先配好；但触发注入要靠指纹，所以提示照给。 -->
                <v:PairingBanner x:Name="PairBanner" />

                <TextBlock x:Name="StatusText" Margin="0,0,0,8" Style="{StaticResource StatusLine}" />

                <!-- 内置支持：随客户端发布的已知目标，点一下只需再填自己的密码。
                     只锁应用身份，不带界面模板（模板会随应用版本失效）。 -->
                <c:SettingCard x:Name="PresetCard" Icon="AppsAddIn24" Title="{loc:Tr inject.presets}"
                               Description="{loc:Tr inject.presets.desc}" Margin="0,0,0,16">
                    <ItemsControl x:Name="PresetPanel" Margin="38,10,0,-8" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </c:SettingCard>

                <ItemsControl x:Name="ListPanel" Focusable="False" />
                <TextBlock x:Name="EmptyText" Text="{loc:Tr inject.empty}" Style="{StaticResource CaptionTertiary}"
                           Visibility="Collapsed" Margin="2,0,0,0" />
            </StackPanel>
        </c:PageContainer>
    </ScrollViewer>
</Page>
