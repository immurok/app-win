<Page x:Class="ImmurokClient.Views.FingerprintPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImmurokClient.Localization"
      xmlns:h="clr-namespace:ImmurokClient.Helpers"
      xmlns:c="clr-namespace:ImmurokClient.Controls"
      xmlns:v="clr-namespace:ImmurokClient.Views"
      Title="{loc:Tr nav.fingerprint}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" h:WheelScroll.Enabled="True">
        <c:PageContainer>
            <StackPanel>
                <!-- 页头：标题 + 说明，命令靠右上；窄到放不下时命令折到说明下面 -->
                <c:AdaptiveRow Margin="0,0,0,20" MinMainWidth="300" TrailingAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr fp.title}" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="CountText" Text="{loc:Tr common.loading}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <ui:Button Content="{loc:Tr common.refresh}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Appearance="Secondary" Margin="0,6,0,0" Click="OnRefreshClick" />
                </c:AdaptiveRow>

                <v:PairingBanner x:Name="PairBanner" />

                <!-- 认证指纹 -->
                <c:SettingCard Icon="Fingerprint24" Title="{loc:Tr fp.auth}" Description="{loc:Tr fp.auth.desc}">
                    <ItemsControl x:Name="SlotPanel" Margin="0,12,0,0" Focusable="False" />
                </c:SettingCard>

                <!-- 切换指纹：录入 / 删除在标题行右侧，当前状态另起一行
                     （状态也挤在右侧的话，长按钮文案会把左边的说明压成窄窄一条） -->
                <c:SettingCard Icon="ArrowSwap24" Title="{loc:Tr fp.switch}" Description="{loc:Tr fp.switch.desc}">
                    <c:SettingCard.Action>
                        <ui:Button x:Name="SwitchBtn" Content="{loc:Tr fp.switch.enroll}" MinWidth="84" Click="OnSwitchClick" />
                    </c:SettingCard.Action>
                    <TextBlock x:Name="SwitchState" Text="—" Style="{StaticResource BodyStrong}" Margin="38,8,0,0" />
                </c:SettingCard>

                <TextBlock x:Name="StatusText" Margin="0,8,0,0" Style="{StaticResource StatusLine}" />
            </StackPanel>
        </c:PageContainer>
    </ScrollViewer>
</Page>
