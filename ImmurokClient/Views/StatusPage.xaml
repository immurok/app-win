<Page x:Class="ImmurokClient.Views.StatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImmurokClient.Localization"
      xmlns:h="clr-namespace:ImmurokClient.Helpers"
      xmlns:c="clr-namespace:ImmurokClient.Controls"
      Title="{loc:Tr nav.status}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" h:WheelScroll.Enabled="True">
        <c:PageContainer>
            <StackPanel>
                <!-- 页头：标题 + 说明，命令靠右上；窄到放不下时命令折到说明下面 -->
                <c:AdaptiveRow Margin="0,0,0,20" MinMainWidth="300" TrailingAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr status.header}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{loc:Tr status.subtitle}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <ui:Button Content="{loc:Tr common.recheck}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Appearance="Secondary" Margin="0,6,0,0" Click="OnRefreshClick" />
                </c:AdaptiveRow>

                <!-- 检查清单：每项一行（StatusPage.AddItem），行间用分隔线 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,4">
                    <StackPanel x:Name="ChecklistPanel">
                        <TextBlock Text="{loc:Tr common.checking}" Style="{StaticResource BodySecondary}" Margin="0,10" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </c:PageContainer>
    </ScrollViewer>
</Page>
